.venv/
venv/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Local environment variables & secrets (keep .env.example committed)
.env
.env.local

